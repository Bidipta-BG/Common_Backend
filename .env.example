# ─────────────────────────────────────────────────────────────────────────────
# Common Backend — Environment Variables
# Copy this file to .env and fill in real values before running the server.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────

# TCP port the Express server listens on (read by server.js)
PORT=3000

# Runtime environment — controls stack trace visibility in error responses.
# Set to 'production' in prod; 'development' locally.
NODE_ENV=development

# ── Supabase (Tambola project) ────────────────────────────────────────────────

# Your Supabase project URL — found in Project Settings → API
TAMBO_SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — NEVER expose to the browser. Used by the backend to
# bypass Row-Level Security and act as a trusted super-admin layer.
TAMBO_SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role_placeholder

# Anon / public key — exported for completeness but NOT used by most backend
# queries (service role client is used instead). Safe to expose to browsers.
TAMBO_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.anon_placeholder

# ── Razorpay ──────────────────────────────────────────────────────────────────

# Razorpay API key ID — returned to frontend for checkout.js initialisation.
# Found in Razorpay Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# Razorpay API key secret — NEVER expose to the browser.
# Used server-side to create orders and verify webhook signatures.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay webhook signing secret — set in Razorpay Dashboard → Webhooks.
# Used by POST /webhooks/razorpay to verify the HMAC-SHA256 signature on
# every incoming event before recording the payment.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── Internal security ─────────────────────────────────────────────────────────

# Shared secret for internal tooling routes (/internal/tenants, /internal/jobs).
# Pass as the X-Internal-Key header. Only your team's scripts / CI should know this.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUPER_ADMIN_API_KEY=change_me_to_a_long_random_secret_32_chars_minimum
