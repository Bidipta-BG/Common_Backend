# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Supabase – StarTambola project ──────────────────────────────────────────
# Anon/public key (respects RLS) — for completeness; rarely used server-side
TAMBO_SUPABASE_URL=https://your-project.supabase.co
TAMBO_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key (bypasses RLS) — used by this backend for all trusted ops
TAMBO_SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── Auth / JWT ────────────────────────────────────────────────────────────────
# Matches the Supabase project JWT secret (Settings -> API -> JWT Secret)
# Used to verify user session tokens explicitly in some routes.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ─── Integrations ──────────────────────────────────────────────────────────────
# Razorpay keys for processing subscription payments
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_KEY_SECRET="secret_xxxxxx"

# -----------------------------------------------------------------------------
# Vercel Integration
# -----------------------------------------------------------------------------
# Used to programmatically attach custom domains to the Next.js frontend
# when a new tenant subscribes.
VERCEL_ACCESS_TOKEN="your-vercel-token"
VERCEL_PROJECT_ID="prj_yourprojectid"
